# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-key-here
LIVEKIT_API_SECRET=your-secret-here

# TTS provider credentials (only the one selected by TTS_PROVIDER is required)
SONIOX_API_KEY=your-key-here
ELEVENLABS_API_KEY=your-key-here

# LLM (Anthropic Claude) — used for the Phase 1 conversational agent
ANTHROPIC_API_KEY=your-key-here

# TTS_PROVIDER: soniox | elevenlabs
TTS_PROVIDER=soniox

# Optional: provider-specific voice id/name. Leave blank to use the provider default.
TTS_VOICE_ID=Maya

# Text spoken to callers on join
GREETING_TEXT=Thank you for calling. Please hold while we connect you.

# Phase 2: which company (by booking-v2 companySlug) this worker serves.
# Will become dynamic per-call in a later phase.
COMPANY_SLUG=your-company-slug
