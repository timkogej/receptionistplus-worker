# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-key-here
LIVEKIT_API_SECRET=your-secret-here

# TTS provider credentials (only the one selected by TTS_PROVIDER is required)
SONIOX_API_KEY=your-key-here
ELEVENLABS_API_KEY=your-key-here

# Azure Speech — evaluation candidate (tools/tts_ab.py), not wired into
# TTS_PROVIDER yet. Region is the Azure resource region (e.g. westeurope),
# not a language code.
AZURE_SPEECH_KEY=your-key-here
AZURE_SPEECH_REGION=your-region-here

# LLM (Anthropic Claude) — used for the Phase 1 conversational agent
ANTHROPIC_API_KEY=your-key-here

# Fallback LLM key (OpenAI), used only if the primary model fails outright
# or declines. Optional — without it there is no fallback.
OPENAI_API_KEY=your-key-here

# Conversation model (agent/llm_factory.py). Defaults shown; pick by running
# evals/run_evals.py, not by feel. "openai:<model>" selects OpenAI.
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=low
# LLM_FALLBACK_MODEL=openai:gpt-5.4-mini

# TTS_PROVIDER: soniox | elevenlabs
TTS_PROVIDER=soniox

# Optional: provider-specific voice id/name. Leave blank to use the provider default.
TTS_VOICE_ID=Maya

# Optional fallback: calls are routed by the dialled number
# (receptionist_phone_numbers or dispatch-rule metadata); numbers with no
# mapping go to this company. Leave empty to reject unmapped numbers.
COMPANY_SLUG=your-company-slug

# Phase 3: direct Supabase REST access for receptionist_* credit/call tables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs booking-v2 requests (required by the n8n workflow in production).
BOOKING_V2_HMAC_SECRET=your-hmac-secret-here
